template pbr-lit
doubleSided false
castShadows true
instanced false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0
roughnessFactor 1
normalScale 1
occlusionStrength 1
emissiveStrength 1
uvScale 1 1
uvOffset 0 0
uvProjection mesh
boxTileSize 1
baseColorTexture 
metallicRoughnessTexture 
normalTexture 
occlusionTexture 
emissiveTexture 
