template custom
vertex Shader/door_panel.vs.hlsl
fragment Shader/door_panel.ps.hlsl
doubleSided false
castShadows true
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0
roughnessFactor 0.5
normalScale 1
occlusionStrength 1
vec4 stripeColor 1 0.75 0.05 1
float stripeSpeed 0.25
float stripeWidth 6
texture panelTex Textures/Testraum/door_panel.png
