template pbr-lit
doubleSided false
castShadows true
instanced false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0.01 0.01 0.01
metallicFactor 0.149
roughnessFactor 0.899
normalScale 4
occlusionStrength 1
uvScale 5 5
baseColorTexture Textures/hoerner_albedo.png
normalTexture Textures/hoerner_normal.png
