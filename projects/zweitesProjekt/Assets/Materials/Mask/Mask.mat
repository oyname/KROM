template pbr-lit
doubleSided false
castShadows true
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0.56
roughnessFactor 0.5
normalScale 1.938
occlusionStrength 1
baseColorTexture Textures/Color.png
normalTexture Textures/normal_mask.png
