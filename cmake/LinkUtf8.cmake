# Linker launcher for MSVC/Ninja. Keep native argument boundaries and make UTF-8
# response files self-identifying before forwarding the original link command.
set(_command)
set(_forward FALSE)
string(ASCII 239 187 191 _utf8_bom)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_index RANGE 0 ${_last})
    set(_arg "${CMAKE_ARGV${_index}}")
    if(NOT _forward)
        if(_arg STREQUAL "--")
            set(_forward TRUE)
        endif()
        continue()
    endif()
    if(_arg MATCHES "^@(.+)$")
        set(_response "${CMAKE_MATCH_1}")
        file(READ "${_response}" _prefix LIMIT 3 HEX)
        # Preserve already marked UTF-8 and UTF-16 files (including user flags).
        if(NOT _prefix MATCHES "^(efbbbf|fffe|feff)")
            file(READ "${_response}" _content)
            file(WRITE "${_response}" "${_utf8_bom}${_content}")
        endif()
    endif()
    string(REPLACE ";" "\\;" _arg "${_arg}")
    list(APPEND _command "${_arg}")
endforeach()
if(NOT _command)
    message(FATAL_ERROR "Missing linker command after --")
endif()
execute_process(COMMAND ${_command} RESULT_VARIABLE _result)
if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "MSVC linker failed (${_result}).")
endif()
