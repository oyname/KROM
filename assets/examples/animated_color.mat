template custom
vertex   examples/animated_color.vs.hlsl
fragment examples/animated_color.ps.hlsl
doubleSided true
castShadows false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0.5
roughnessFactor 0.4
normalScale 1
occlusionStrength 1
