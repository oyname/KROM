template pbr-lit
doubleSided false
castShadows true
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0
roughnessFactor 0.894
normalScale 2.5
occlusionStrength 1
uvScale 2 2
baseColorTexture Textures/haut_albedo.png
normalTexture Textures/haut_norma.png
