@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "This Krom package requires Windows x64 and MSVC")
endif()
if(NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "x64")
    message(FATAL_ERROR "This Krom package requires the x64 compiler, not ARM64 or x86")
endif()
if(CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "This Krom SDK only supplies Release libraries; use Ninja with CMAKE_BUILD_TYPE=Release")
endif()
if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "@CMAKE_CXX_COMPILER_VERSION@" OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_LESS 19.50)
    message(FATAL_ERROR "Krom requires MSVC @CMAKE_CXX_COMPILER_VERSION@ or newer in the supported v143 family (below 19.50)")
endif()
foreach(_flags CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_RELEASE CMAKE_EXE_LINKER_FLAGS CMAKE_EXE_LINKER_FLAGS_RELEASE CMAKE_SHARED_LINKER_FLAGS CMAKE_SHARED_LINKER_FLAGS_RELEASE)
    if("${${_flags}}" MATCHES "[-/](GL|LTCG)([: ;]|$)")
        message(FATAL_ERROR "Krom SDK consumers must not enable /GL or /LTCG")
    endif()
endforeach()
if(CMAKE_INTERPROCEDURAL_OPTIMIZATION)
    message(FATAL_ERROR "Krom SDK consumers must disable IPO")
endif()
if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "Krom SDK requires the Release dynamic runtime (/MD)")
endif()
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
file(WRITE "${CMAKE_BINARY_DIR}/krom-compiler-version.cpp" "KROM_COMPILER_VERSION _MSC_FULL_VER\n")
execute_process(COMMAND "${CMAKE_CXX_COMPILER}" /nologo /EP /TP "${CMAKE_BINARY_DIR}/krom-compiler-version.cpp"
    OUTPUT_VARIABLE _krom_compiler_probe RESULT_VARIABLE _krom_compiler_status)
if(NOT _krom_compiler_status EQUAL 0 OR NOT _krom_compiler_probe MATCHES "KROM_COMPILER_VERSION +([0-9]+)")
    message(FATAL_ERROR "Cannot validate the Krom SDK compiler contract")
endif()
if(CMAKE_MATCH_1 LESS @KROM_SDK_COMPILER_VERSION@ OR CMAKE_MATCH_1 GREATER_EQUAL 195000000)
    message(FATAL_ERROR "Krom requires _MSC_FULL_VER >= @KROM_SDK_COMPILER_VERSION@ and < 195000000")
endif()
set(Krom_SDK_ROOT "${PACKAGE_PREFIX_DIR}")
set(Krom_SDK_BUILD_ID "@KROM_SDK_BUILD_ID@")
if(DEFINED KROM_CACHED_SDK_BUILD_ID AND NOT KROM_CACHED_SDK_BUILD_ID STREQUAL Krom_SDK_BUILD_ID)
    message(FATAL_ERROR "SDK build ID changed; use a fresh project build directory")
endif()
set(KROM_CACHED_SDK_BUILD_ID "${Krom_SDK_BUILD_ID}" CACHE INTERNAL "Full immutable SDK identity")
set(Krom_SDK_COMPILER_VERSION "@KROM_SDK_COMPILER_VERSION@")
set(Krom_SDK_TOOLSET "@KROM_SDK_TOOLSET@")
set(KROM_PROJECT_SUPPORT_ROOT "${Krom_SDK_ROOT}/sources")
set(KROM_ENGINE_RESOURCES_DIR "${Krom_SDK_ROOT}/bin")
set(KROM_LICENSE_FILE "${Krom_SDK_ROOT}/LICENSE")
set(KROM_TARGET_NAMESPACE "Krom::")
set(KROM_SHOW_CONSOLE ON)
file(GLOB KROM_MSVC_RUNTIME_DLLS "${Krom_SDK_ROOT}/bin/msvcp*.dll" "${Krom_SDK_ROOT}/bin/vcruntime*.dll" "${Krom_SDK_ROOT}/bin/concrt*.dll")
if(EXISTS "${Krom_SDK_ROOT}/lib/Release/vulkan-1.lib" AND NOT TARGET Vulkan::Vulkan)
    add_library(Vulkan::Vulkan UNKNOWN IMPORTED)
    set_target_properties(Vulkan::Vulkan PROPERTIES
        IMPORTED_LOCATION "${Krom_SDK_ROOT}/lib/Release/vulkan-1.lib"
        INTERFACE_INCLUDE_DIRECTORIES "${Krom_SDK_ROOT}/include")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/KromTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/KromProjects.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/KromProjectTargets.cmake")
function(krom_apply_console_option target)
    # Game runtimes use krom_apply_release_runtime_options below.
endfunction()
check_required_components(Krom)
