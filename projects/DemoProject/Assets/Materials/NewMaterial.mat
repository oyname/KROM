template pbr-lit
doubleSided false
castShadows true
instanced false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0.377000004
roughnessFactor 0.566999972
normalScale 4
occlusionStrength 0
uvScale 1 1
uvOffset 0 0
uvProjection box
boxTileSize 20
baseColorTexture Textures/checkered_pavement_tiles_diff_2k.png
metallicRoughnessTexture 
normalTexture Textures/checkered_pavement_tiles_nor_dx_2k.png
occlusionTexture 
emissiveTexture 
graphOutputs 1 0 2 0 0 0 0 0
graphNode 1 0 0 0 1 1 1 96 28 "Textures/checkered_pavement_tiles_diff_2k.png"
graphNode 2 0 0 0 1 1 1 98 145.5 "Textures/checkered_pavement_tiles_nor_dx_2k.png"
