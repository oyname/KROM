template pbr-lit
doubleSided false
castShadows true
instanced false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 0 0 1
emissiveFactor 0 0 0
metallicFactor 1
roughnessFactor 0.108999997
normalScale 1
occlusionStrength 1
uvScale 1 1
uvOffset 0 0
baseColorTexture 
metallicRoughnessTexture 
normalTexture 
occlusionTexture 
emissiveTexture 
