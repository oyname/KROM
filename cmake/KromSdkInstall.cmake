if(NOT KROM_BUILD_SDK)
    return()
endif()
include(CMakePackageConfigHelpers)

function(krom_collect_sdk_targets directory output)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        krom_collect_sdk_targets("${_child}" _nested)
        list(APPEND _targets ${_nested})
    endforeach()
    set(${output} "${_targets}" PARENT_SCOPE)
endfunction()
krom_collect_sdk_targets("${CMAKE_SOURCE_DIR}" _krom_all_targets)
set(_krom_libraries)
foreach(_target IN LISTS _krom_all_targets)
    if((_target MATCHES "^engine_" AND NOT _target STREQUAL "engine_editor") OR _target STREQUAL "Jolt")
        get_target_property(_kind "${_target}" TYPE)
        if(_kind STREQUAL "STATIC_LIBRARY" OR _kind STREQUAL "INTERFACE_LIBRARY")
            list(APPEND _krom_libraries "${_target}")
            # Preserve existing build-only paths, add a single relocatable include
            # root for the installed include/ and include/addons/ hierarchy.
            get_target_property(_includes "${_target}" INTERFACE_INCLUDE_DIRECTORIES)
            set(_public_includes "$<INSTALL_INTERFACE:include>")
            if(_includes)
                foreach(_include IN LISTS _includes)
                    if(_include MATCHES "^\\$<")
                        list(APPEND _public_includes "${_include}")
                    else()
                        list(APPEND _public_includes "$<BUILD_INTERFACE:${_include}>")
                    endif()
                endforeach()
            endif()
            set_target_properties("${_target}" PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_public_includes}"
                INTERPROCEDURAL_OPTIMIZATION OFF)
        endif()
    endif()
endforeach()
if(KROM_HAS_SHADERC)
    message(FATAL_ERROR "The SDK uses bundled shader tools; build with shaderc package discovery disabled")
endif()
install(TARGETS ${_krom_libraries} EXPORT KromTargets ARCHIVE DESTINATION lib/Release CONFIGURATIONS Release)
foreach(_backend IN ITEMS dx11 vulkan)
    if(TARGET krom_editor_${_backend})
        install(TARGETS krom_editor_${_backend} RUNTIME DESTINATION bin CONFIGURATIONS Release)
    endif()
endforeach()
install(EXPORT KromTargets NAMESPACE Krom:: DESTINATION cmake CONFIGURATIONS Release)
install(DIRECTORY include/ DESTINATION include FILES_MATCHING PATTERN "*.hpp" PATTERN "*.h")
install(DIRECTORY addons/ DESTINATION include/addons FILES_MATCHING PATTERN "*.hpp" PATTERN "editor" EXCLUDE)
if(TARGET Jolt)
    install(DIRECTORY "${joltphysics_SOURCE_DIR}/Jolt/" DESTINATION include/Jolt FILES_MATCHING PATTERN "*.h" PATTERN "*.inl")
endif()
if(KROM_BUILD_VULKAN AND Vulkan_LIBRARY AND EXISTS "${Vulkan_LIBRARY}")
    install(FILES "${Vulkan_LIBRARY}" DESTINATION lib/Release RENAME vulkan-1.lib)
    install(DIRECTORY "${Vulkan_INCLUDE_DIR}/vulkan" "${Vulkan_INCLUDE_DIR}/vk_video" DESTINATION include)
endif()
install(DIRECTORY assets shaders editor DESTINATION bin)
install(DIRECTORY licenses DESTINATION bin)
install(FILES LICENSE DESTINATION .)
install(FILES LICENSE DESTINATION bin/licenses RENAME KROM-LICENSE.txt)
install(FILES ${KROM_MSVC_RUNTIME_DLLS} DESTINATION bin)
# Only the Windows SDK redist copy may be shipped; never fall back to System32.
set(_krom_programfiles_x86_var "ProgramFiles(x86)")
foreach(_runtime IN ITEMS d3dcompiler_47.dll)
    find_file(_krom_redist_${_runtime} "${_runtime}" PATHS
        "$ENV{WindowsSdkDir}/Redist/D3D/x64"
        "$ENV{${_krom_programfiles_x86_var}}/Windows Kits/10/Redist/D3D/x64"
        "C:/Program Files (x86)/Windows Kits/10/Redist/D3D/x64"
        NO_DEFAULT_PATH)
    if(_krom_redist_${_runtime})
        install(FILES "${_krom_redist_${_runtime}}" DESTINATION bin)
    else()
        message(FATAL_ERROR
            "SDK redistributable missing: ${_runtime}. It must come from the Windows SDK "
            "(Windows Kits/10/Redist/D3D/x64); the System32 copy may not be redistributed. "
            "Install the Windows SDK via the Visual Studio Installer (\"Windows 11 SDK\" or "
            "\"Windows 10 SDK\" under Individual components) and package again.")
    endif()
endforeach()
find_program(_krom_dxc dxc HINTS "$ENV{VULKAN_SDK}/Bin")
if(NOT _krom_dxc)
    message(FATAL_ERROR "SDK packaging requires dxc.exe (bundled shader compiler)")
endif()
get_filename_component(_krom_dxc_directory "${_krom_dxc}" DIRECTORY)
install(PROGRAMS "${_krom_dxc}" DESTINATION bin/tools)
foreach(_dll IN ITEMS dxcompiler.dll dxil.dll)
    if(EXISTS "${_krom_dxc_directory}/${_dll}")
        install(FILES "${_krom_dxc_directory}/${_dll}" DESTINATION bin/tools)
    endif()
endforeach()
install(FILES addons/script/ScriptModuleEntry.cpp DESTINATION sources/addons/script)
install(FILES examples/editor_scene_runtime.cpp DESTINATION sources/examples)
install(DIRECTORY templates/project DESTINATION templates)
install(FILES cmake/KromProjects.cmake cmake/KromProjectTargets.cmake cmake/WriteScriptModulePdb.cmake cmake/LinkUtf8.cmake DESTINATION cmake)
configure_package_config_file(cmake/KromConfig.cmake.in "${CMAKE_BINARY_DIR}/sdk/KromConfig.cmake" INSTALL_DESTINATION cmake)
write_basic_package_version_file("${CMAKE_BINARY_DIR}/sdk/KromConfigVersion.cmake" VERSION "${PROJECT_VERSION}" COMPATIBILITY SameMajorVersion)
install(FILES "${CMAKE_BINARY_DIR}/sdk/KromConfig.cmake" "${CMAKE_BINARY_DIR}/sdk/KromConfigVersion.cmake" DESTINATION cmake)
configure_file(cmake/krom-sdk.json.in "${CMAKE_BINARY_DIR}/sdk/krom-sdk.json" @ONLY)
install(FILES "${CMAKE_BINARY_DIR}/sdk/krom-sdk.json" DESTINATION .)
add_custom_target(krom_sdk DEPENDS ${_krom_libraries})
foreach(_backend IN ITEMS dx11 vulkan)
    if(TARGET krom_editor_${_backend})
        add_dependencies(krom_sdk krom_editor_${_backend})
    endif()
endforeach()
