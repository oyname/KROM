# Project selection is shared by script DLLs and all runtime backends.
# The new name takes precedence, including an explicitly empty value.
if(NOT DEFINED KROM_PROJECT_ROOT)
    if(KROM_PROJECT_SCRIPT_ROOT)
        message(WARNING "KROM_PROJECT_SCRIPT_ROOT is deprecated; use KROM_PROJECT_ROOT instead.")
    endif()
    set(KROM_PROJECT_ROOT "${KROM_PROJECT_SCRIPT_ROOT}" CACHE PATH "Additional KROM project root")
else()
    # Distinguish a newly supplied legacy value from our unchanged cache mirror.
    # A normal editor switch only changes the new name and should not warn.
    if(DEFINED KROM_PROJECT_SCRIPT_ROOT AND
       NOT "${KROM_PROJECT_SCRIPT_ROOT}" STREQUAL "${KROM_PROJECT_ROOT}" AND
       (NOT DEFINED _KROM_PROJECT_ROOT_ALIAS_VALUE OR
        NOT "${KROM_PROJECT_SCRIPT_ROOT}" STREQUAL "${_KROM_PROJECT_ROOT_ALIAS_VALUE}"))
        message(WARNING "KROM_PROJECT_SCRIPT_ROOT is deprecated and ignored because KROM_PROJECT_ROOT is already defined. Use -DKROM_PROJECT_ROOT=... to change the selection.")
    endif()
    set(KROM_PROJECT_ROOT "${KROM_PROJECT_ROOT}" CACHE PATH "Additional KROM project root")
endif()
if(NOT "${KROM_PROJECT_ROOT}" STREQUAL "")
    file(REAL_PATH "${KROM_PROJECT_ROOT}" _krom_selected_root BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${_krom_selected_root}/krom-project.json")
        message(WARNING "Ignoring KROM_PROJECT_ROOT '${_krom_selected_root}': no krom-project.json (project moved, renamed or deleted). Clearing the cached selection.")
        set(_krom_selected_root "")
    endif()
    set(KROM_PROJECT_ROOT "${_krom_selected_root}" CACHE PATH "Additional KROM project root" FORCE)
endif()
# Keep old caches/scripts usable without resurrecting an old external selection.
set(KROM_PROJECT_SCRIPT_ROOT "${KROM_PROJECT_ROOT}" CACHE PATH
    "Deprecated alias of KROM_PROJECT_ROOT" FORCE)
set(_KROM_PROJECT_ROOT_ALIAS_VALUE "${KROM_PROJECT_ROOT}" CACHE INTERNAL
    "Last value mirrored to KROM_PROJECT_SCRIPT_ROOT" FORCE)
mark_as_advanced(KROM_PROJECT_SCRIPT_ROOT)

# Ninja writes UTF-8 response files without a BOM. MSVC link.exe otherwise reads
# them in the system code page, corrupting Unicode project/object paths.
function(krom_enable_unicode_link target)
    if(MSVC AND CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
        set(_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/LinkUtf8.cmake")
        get_property(_existing TARGET ${target} PROPERTY CXX_LINKER_LAUNCHER)
        set(_launcher "${CMAKE_COMMAND}" -P "${_script}" --)
        if(_existing)
            list(APPEND _launcher ${_existing})
        endif()
        set_property(TARGET ${target} PROPERTY CXX_LINKER_LAUNCHER "${_launcher}")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${_script}")
    endif()
endfunction()

function(krom_sanitize_identifier input out_var)
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" _sanitized "${input}")
    if(_sanitized STREQUAL "")
        set(_sanitized "KromGame")
    endif()
    if(_sanitized MATCHES "^[0-9]")
        set(_sanitized "Krom_${_sanitized}")
    endif()
    set(${out_var} "${_sanitized}" PARENT_SCOPE)
endfunction()

function(krom_read_project_runtime_target project_root out_var)
    set(_runtime_target "")
    set(_project_file "${project_root}/krom-project.json")
    if(EXISTS "${_project_file}")
        file(READ "${_project_file}" _project_json)
        string(REGEX MATCH "\"runtimeTarget\"[ \t\r\n]*:[ \t\r\n]*\"([^\"]+)\"" _runtime_match "${_project_json}")
        if(_runtime_match)
            set(_runtime_target "${CMAKE_MATCH_1}")
        else()
            string(REGEX MATCH "\"name\"[ \t\r\n]*:[ \t\r\n]*\"([^\"]+)\"" _name_match "${_project_json}")
            if(_name_match)
                set(_runtime_target "${CMAKE_MATCH_1}")
            endif()
        endif()
    endif()
    if(_runtime_target STREQUAL "")
        get_filename_component(_runtime_target "${project_root}" NAME)
    endif()
    krom_sanitize_identifier("${_runtime_target}" _runtime_target)
    set(${out_var} "${_runtime_target}" PARENT_SCOPE)
endfunction()

function(krom_collect_projects out_var)
    file(GLOB _manifests CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/projects/*/krom-project.json")
    set(_candidates)
    foreach(_manifest IN LISTS _manifests)
        get_filename_component(_root "${_manifest}" DIRECTORY)
        list(APPEND _candidates "${_root}")
    endforeach()
    if(NOT "${KROM_PROJECT_ROOT}" STREQUAL "")
        list(APPEND _candidates "${KROM_PROJECT_ROOT}")
    endif()
    set(_roots)
    set(_path_keys)
    set(_target_keys)
    foreach(_candidate IN LISTS _candidates)
        file(REAL_PATH "${_candidate}" _root)
        set(_path_key "${_root}")
        if(WIN32)
            string(TOLOWER "${_path_key}" _path_key)
        endif()
        if(_path_key IN_LIST _path_keys)
            continue()
        endif()
        krom_read_project_runtime_target("${_root}" _identifier)
        set(_target_key "${_identifier}")
        if(WIN32)
            string(TOLOWER "${_target_key}" _target_key)
        endif()
        list(FIND _target_keys "${_target_key}" _collision)
        if(NOT _collision EQUAL -1)
            list(GET _roots ${_collision} _other)
            message(FATAL_ERROR "KROM project target collision '${_identifier}':\n  ${_other}\n  ${_root}\nSet a unique runtimeTarget in krom-project.json for each project.")
        endif()
        list(APPEND _roots "${_root}")
        list(APPEND _path_keys "${_path_key}")
        list(APPEND _target_keys "${_target_key}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_root}/krom-project.json")
    endforeach()
    set(${out_var} "${_roots}" PARENT_SCOPE)
endfunction()
