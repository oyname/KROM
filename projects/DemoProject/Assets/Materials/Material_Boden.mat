template pbr-lit
doubleSided false
castShadows true
instanced false
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0.5
roughnessFactor 0.5
normalScale 4
occlusionStrength 0
uvScale 5 5
uvOffset 0 0
baseColorTexture Textures/cobblestone_floor_09_diff_2k.png
metallicRoughnessTexture 
normalTexture Textures/cobblestone_floor_09_nor_dx_2k.png
occlusionTexture 
emissiveTexture 
