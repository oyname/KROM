template pbr-lit
doubleSided false
castShadows true
transparent false
alphaMode opaque
alphaCutoff 0.5
baseColorFactor 1 1 1 1
emissiveFactor 0 0 0
metallicFactor 0.058
roughnessFactor 0.691
normalScale 3.221
occlusionStrength 1
baseColorTexture Textures/sattel_albedo.png
normalTexture Textures/sattel_normal.png
