# Build-Ausgaben
/build/
/out/
/_deps/
*.pdb
*.ilk
*.obj
*.exe
*.lib
*.exp

# IDE / lokale Einstellungen
/.vs/
# Claude Code (persoenliche Einstellungen, Worktrees)
/.claude/

# Generierte Shader / Caches
/shader_artifacts/
/.krom/
projects/*/.krom/
projects/*/shader-bin/
projects/*/Build/
projects/*/shader_artifacts/
projects/*/generated/*
!projects/*/generated/ScriptBindings.cpp
*.iblcache

# Logs und temporäre Dateien
*.log
_tmp_*

# Ablage / Fremdcode zur Ansicht
/ablage/
/_inspect_flax_windows/

# Project textures: only files referenced by scenes/materials/prefabs are
# tracked (added with `git add -f`); unused local textures stay out of the repo.
projects/*/Assets/Textures/*
!projects/*/Assets/Textures/Testraum/

# Live-State der laufenden Runtime (wird bei jedem Start neu geschrieben)
projects/*/editor/runtime-state.json

# Temp-Ordner von Visual Studio (Encoding-Konvertierung)
/enc_temp_folder/

# Lokaler Editor-Zustand
/imgui.ini
projects/*/editor/last-opened.txt
projects/*/editor/backups/

# graphify knowledge graph output
graphify-out/
graphify-out-src-only/
